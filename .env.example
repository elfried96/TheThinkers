# Variables d'environnement pour les deux APIs
# Copiez ce fichier vers .env et remplissez les valeurs

# API Google Gemini (obligatoire pour les deux services)
GOOGLE_API_KEY=your_google_api_key_here

# Configuration serveur
PORT=8000
ENVIRONMENT=development

# Configuration ANDFChat
ANDFCHAT_DEBUG=true
ANDFCHAT_LOG_LEVEL=INFO

# Configuration API IA
IA_API_DEBUG=true
IA_API_LOG_LEVEL=INFO
IA_MAX_FILE_SIZE=50MB
IA_PROCESSING_TIMEOUT=300

# Configuration Docker
COMPOSE_PROJECT_NAME=hackia