  "faq_communes": [
    {
      "question": "Combien coûte un titre foncier au Bénin?",
      "reponse": "100.000 FCFA hors frais de bornage contradictoire pour un titre foncier standard. 160.000 FCFA pour établissement à partir d'un permis d'habiter."
    },
    {
      "question": "Quelle est la durée pour obtenir un titre foncier?",
      "reponse": "120 jours maximum en l'absence de contestation, selon l'article 139 du Code foncier."
    },
    {
      "question": "Peut-on faire les démarches en ligne?",
      "reponse": "Oui, depuis janvier 2025 via la plateforme e-Notaire. Les transactions peuvent se faire en 72h en ligne."
    },
    {
      "question": "Quels documents faut-il pour un titre foncier?",
      "reponse": "Pièce d'identité, documents de présomption de propriété (ADC, attestation recasement, etc.), plan topographique, fiche de demande."
    },
    {
      "question": "Combien coûte une mutation de titre foncier?",
      "reponse": "0,3% de la valeur marchande du bien avec un minimum de 30.000 FCFA."
    }
  ],

